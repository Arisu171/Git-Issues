# Dùng khi chạy API trực tiếp bằng `dotnet run` (không qua docker compose).
# Với compose, cấu hình lấy từ .env ở thư mục gốc.
#
# KHÔNG nạp bằng `source .env` — tệp này không phải script shell. Dấu `;` trong chuỗi kết nối
# cắt cụt giá trị trong im lặng (CONNECTIONSTRINGS__DEFAULT còn mỗi `Host=localhost`, lỗi mãi
# sau mới lộ), còn `$( )` và backtick thì bị THỰC THI — trên một tệp chứa mật khẩu. Đây đúng là
# lý do infra/scripts/backup.sh đọc từng khoá thay vì source. Nạp an toàn, hoặc dùng
# `dotnet user-secrets`:
#     set -a; while IFS='=' read -r k v; do case "$k" in ''|\#*) continue;; esac; export "$k=$v"; done < .env; set +a

CONNECTIONSTRINGS__DEFAULT=Host=localhost;Port=5432;Database=gitissues;Username=gitissue;Password=doi-mat-khau-nay
JWT__SIGNINGKEY=doi-khoa-nay-toi-thieu-32-ky-tu-truoc-khi-chay
JWT__ISSUER=gitissues-api
JWT__AUDIENCE=gitissues-web
JWT__EXPIRYMINUTES=15
SEED__APPLYMIGRATIONS=true
SEED__ADMINEMAIL=admin@gitissues.local
SEED__ADMINPASSWORD=doi-mat-khau-admin-nay

# Tài khoản `system` — không có mặc định trong mã, bỏ trống thì admin giữ tạm vai trò đó.
SEED__SYSTEMEMAIL=
SEED__SYSTEMPASSWORD=
# Nạp dữ liệu trình diễn lúc khởi động (DemoDataHostedService). Mặc định false.
SEED__DEMODATA=false
# Bỏ trống = theo môi trường; đặt true để bật tường minh ở nơi không phải Development.
SWAGGER__ENABLED=
RATELIMIT__LOGINPERMINUTE=10
RATELIMIT__REGISTERPERHOUR=5
REGISTRATION__ENABLED=true
REGISTRATION__ALLOWEDEMAILDOMAINS=
REGISTRATION__REQUIREAPPROVAL=false
REGISTRATION__DEFAULTROLES=customer
REGISTRATION__MINPASSWORDLENGTH=8
SLA__INVESTIGATINGHOURS=24
SLA__MITIGATINGHOURS=48
SLA__SCANINTERVALMINUTES=15
# Phản hồi tự động: chèn lời xác nhận tiếp nhận vào luồng trả lời của phản hồi mới (FR-BIZ-14).
FEEDBACK__AUTOACKENABLED=true
# Bỏ trống dòng dưới để dùng nội dung mặc định trong appsettings.json.
#FEEDBACK__AUTOACKMESSAGE=
OBSERVABILITY__ENABLEPROMETHEUS=true
OBSERVABILITY__TRACESAMPLERATIO=0.1
SECURITY__REQUIREHTTPS=false
CORS__ALLOWEDORIGINS__0=http://localhost:3000
# Gốc địa chỉ web, dùng dựng link trong webhook và thông báo gửi ra ngoài.
TICKETING__PUBLICBASEURL=http://localhost:3000
# Gốc địa chỉ API, dùng dựng link tải tệp đính kèm công khai.
TICKETING__PUBLICAPIBASEURL=http://localhost:8080
# Số message MassTransit xử lý song song (mặc định 4). Pool kết nối phải lớn hơn
# (số consumer × giá trị này), nếu không health check db sẽ timeout — app cảnh báo lúc khởi động.
TICKETING__CONSUMERCONCURRENCY=4
# Địa chỉ health của web để /api/health/system soi được cả ba service.
HEALTHCHECKS__WEBURL=http://localhost:3000/healthz
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080
# Chỉ dùng khi nền tảng tự chọn cổng (Render tiêm sẵn PORT). Cục bộ thì ASPNETCORE_URLS là đủ.
#PORT=8080

# Chuỗi kết nối dùng cho integration test (tạo/hủy database tạm trong lúc chạy), nên role phải
# có quyền CREATEDB. Trỏ vào backend/docker-compose.yml, KHÔNG phải service `db` của compose
# gốc — ở đó role là `gitissue` và không tồn tại role `postgres`.
TEST_DB_CONNECTION=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres

# --- Nạp quyền theo request (ADR-004) ---
# Token chỉ mang danh tính; vai trò và permission đọc từ database ở mỗi request.
# 0 = luôn đọc mới, thu hồi quyền có hiệu lực tức thì (khuyến nghị).
# Đặt > 0 để giảm số truy vấn, đổi lại quyền vừa gỡ còn hiệu lực đúng chừng ấy giây.
AUTH__PERMISSIONCACHESECONDS=0
